# Neon (veya başka bir Postgres sağlayıcısı) bağlantı adresi.
# Neon panelinde "Connection string" olarak görünen değeri buraya yapıştır.
# Bu dosyayı .env olarak kopyala, gerçek değeri gir, ve .env'i ASLA git'e ekleme.
DATABASE_URL=postgresql://kullanici:sifre@ep-xxxx.neon.tech/dbname?sslmode=require

# Oturum token'larını imzalamak için rastgele, uzun bir metin (örn. `openssl rand -hex 32`).
JWT_SECRET=degistir-bunu-rastgele-uzun-bir-metinle

# Platform (uygulama sahibi) girişi — sadece sen kullanacaksın.
# Şifrenin hash'ini üretmek için: node hash-password.js "sifren"
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD_HASH=node-hash-password-js-ile-uret
